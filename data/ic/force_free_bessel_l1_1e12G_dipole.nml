! Force-free Bessel-Riccati l=1 (dipole) eigenmode, amplitude-tuned so
! the radial field at the magnetic pole equals ~10^12 G AT THE SURFACE
! (per user request, 2026-10-16). OUTER_BC='arbitrary_value' is required
! here, not 'double_dirichlet' -- the latter forces B_r(R_out)=0
! identically (see force_free_bessel.f90's own header), which is exactly
! what we do NOT want for a nonzero surface field.
!
! AMPLITUDE derivation: at the magnetic pole (theta=0, where the l=1
! angular factor P_1(cos0)=1), B_r(r) = l(l+1)/r**2 * Phi(r) = 2/r**2 *
! Phi(r) (code units: B in 10**12 G, length in km -- src/core/units.f90).
! 'arbitrary_value' normalizes Phi(R_out) to exactly AMPLITUDE (the V=1
! mix scaled by AMPLITUDE, see force_free_bessel.f90's header), so
! requiring B_r(pole,R_out) = 1.0 (i.e. 10**12 G) gives
!   AMPLITUDE = B_r_target * R_out**2 / 2 = 1.0 * R_out**2 / 2.
! R_out here is this driver's own live TOV-derived, theta-truncated crust
! surface (CRUST_CONDUCTIVITY::FIND_TRUNCATION_RADIUS, T_KELVIN=1e9K,
! THETA_MAX=1.3 -- matches app/mhdvsh_hall_crust_profile.f90 exactly),
! computed once (2026-10-16) as R_out=11.56212283471523 km, giving
! AMPLITUDE=66.84134222252167 -- hardcoded here (same convention already
! used by bessel_riccati_example.nml's own X_SCALE) since the EOS/TOV
! inputs this depends on (NBAR_CENTRAL, data/eos/APR_EOS_Cat.dat) are
! fixed constants, not expected to change run to run.
&IC_SELECT
  N_TAGS = 1
  TAGS   = 'force_free_bessel'
/

&FORCE_FREE_BESSEL_MODES
  N_FF_MODES          = 1
  FF_MODE_L           = 1
  FF_MODE_M           = 0
  FF_MODE_ROOT_INDEX  = 1
  FF_MODE_AMPLITUDE   = 66.84134222252167
  FF_MODE_OUTER_BC    = 'arbitrary_value'
/
